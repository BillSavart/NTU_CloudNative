POSTGRES_DB=access_control
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_SEED_PASSWORD=demo123
FRONTEND_HOST_PORT=5173
TEMPO_HOST_PORT=3200
ALLOY_OTLP_GRPC_HOST_PORT=14317
ALLOY_OTLP_HTTP_HOST_PORT=14318

# --- Production deploy (docker-compose.prod.yml) ---
# Long random value, e.g. `openssl rand -hex 32`. Used to sign auth sessions.
APP_SECRET_KEY=replace-with-a-long-random-secret

# --- HTTPS edge (docker-compose.https.yml, Caddy + Let's Encrypt) ---
# Set ENABLE_HTTPS=true to make scripts/deploy.sh bring up the Caddy TLS edge.
# Each domain below needs its own A record pointing at the VM's static IP.
ENABLE_HTTPS=false
DOMAIN=tsmc-dpac.systems
GRAFANA_DOMAIN=grafana.tsmc-dpac.systems
PROMETHEUS_DOMAIN=prometheus.tsmc-dpac.systems
# Basic-auth for Prometheus (it has no auth of its own). Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
PROM_USER=admin
PROM_HASH=
# With HTTPS on, mark auth cookies Secure and lock CORS to your https origin.
APP_COOKIE_SECURE=true
CORS_ORIGINS=https://tsmc-dpac.systems
