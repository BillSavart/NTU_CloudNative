    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Resilience signal during DB/Kafka chaos. Buffered/sec should SPIKE while Kafka is down (events safely held in the Redis recovery stream). Dropped/sec must stay at 0 — any non-zero value means real data loss.",
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Dropped/sec"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
